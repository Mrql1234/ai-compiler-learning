    %14 = llvm.load %13 : !llvm.ptr -> f32
    llvm.return %14 : f32
  }
  llvm.func @_mlir_ciface_run() -> f32 attributes {llvm.emit_c_interface} {
    %0 = llvm.call @run() : () -> f32
    llvm.return %0 : f32
  }
  llvm.func @mgpuMemAlloc(i64, !llvm.ptr, i8) -> !llvm.ptr
}

