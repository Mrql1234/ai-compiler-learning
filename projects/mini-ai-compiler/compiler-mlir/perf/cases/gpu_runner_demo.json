{
  "name": "gpu_runner_demo",
  "description": "Small runnable GPU demo used as the first compiler-generated kernel perf case.",
  "input": "test/gpu_runner_demo.mlir",
  "entry_function": "run",
  "result_type": "f32",
  "problem": {
    "operation": "linear_relu",
    "data_profile": "gpu_runner_demo",
    "m": 2,
    "n": 8,
    "k": 4
  },
  "tolerance": {
    "abs": 1.0e-5,
    "rel": 1.0e-5
  },
  "backends": [
    {
      "name": "mlir_nvvm",
      "kind": "mlir_gpu_runner",
      "kernel_backend": "generated_nvvm",
      "enabled": true,
      "gpu_chip": "sm_86",
      "cubin_format": "fatbin",
      "opt_level": 3
    },
    {
      "name": "cuda_hand",
      "kind": "external",
      "enabled": false,
      "run_once": true,
      "command": [
        "./build/bin/mini-compiler-kernel-bench",
        "--backend",
        "cuda_hand",
        "--case",
        "{case}",
        "--warmup",
        "{warmup}",
        "--repeat",
        "{repeat}",
        "--json-output",
        "{json_output}"
      ]
    },
    {
      "name": "cublas",
      "kind": "external",
      "enabled": false,
      "run_once": true,
      "command": [
        "./build/bin/mini-compiler-kernel-bench",
        "--backend",
        "cublas",
        "--case",
        "{case}",
        "--warmup",
        "{warmup}",
        "--repeat",
        "{repeat}",
        "--json-output",
        "{json_output}"
      ]
    }
  ]
}
