{
  "name": "linear_relu_f32_m1024_n1024_k1024",
  "description": "Large CUDA library/hand-kernel linear+relu case for cloud GPU performance monitoring.",
  "input": "test/gpu_runner_demo.mlir",
  "entry_function": "run",
  "result_type": "f32",
  "problem": {
    "operation": "linear_relu",
    "data_profile": "deterministic",
    "m": 1024,
    "n": 1024,
    "k": 1024
  },
  "tolerance": {
    "abs": 1.0e-3,
    "rel": 1.0e-3
  },
  "backends": [
    {
      "name": "cuda_hand",
      "kind": "mlir_gpu_runner",
      "kernel_backend": "cuda_hand",
      "enabled": true,
      "run_once": true
    },
    {
      "name": "cublas",
      "kind": "mlir_gpu_runner",
      "kernel_backend": "cublas",
      "enabled": true,
      "run_once": true
    }
  ]
}
